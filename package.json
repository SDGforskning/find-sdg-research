{
  "name": "find-sdg-research",
  "private": true,
  "version": "2.0.0",
  "description": "",
  "author": [
    {
      "name": "SDGForskning",
      "url": "https://github.com/SDGforskning"
    },
    {
      "name": "Tarje Lavik",
      "url": "https://github.com/tarjelavik"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SDGforskning/find-sdg-research.git"
  },
  "license": "CC BY 4.0",
  "bugs": {
    "url": "https://github.com/SDGforskning/find-sdg-research/issues"
  },
  "homepage": "https://baerekraftsforskning.no",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dotenvx": "dotenvx",
    "dev": "dotenvx run -- next dev --turbo",
    "build": "dotenvx run -- next build",
    "start": "dotenvx run -- next start",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "prepare": "lefthook install",
    "lint": "biome check",
    "lint:links": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts-paths.mjs ./scripts/lint.ts",
    "format": "biome format --write",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/a11y"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "2.38.2",
    "@dotenvx/next-env": "2.2.3",
    "@elastic/react-search-ui": "^1.24.2",
    "@elastic/react-search-ui-views": "^1.24.2",
    "@elastic/search-ui": "^1.24.2",
    "@elastic/search-ui-elasticsearch-connector": "^1.24.2",
    "@stoddabr/react-tableau-embed-live": "^0.3.34",
    "fumadocs-core": "16.19.7",
    "fumadocs-mdx": "15.6.4",
    "fumadocs-ui": "16.19.7",
    "lucide-react": "^1.81.0",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@biomejs/biome": "^2.6.9",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.6.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "lefthook": "2.2.4",
    "next-validate-link": "1.6.7",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@next/env": "npm:@dotenvx/next-env"
  }
}
